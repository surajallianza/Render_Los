        {
          "name": "Submit Onboarding (DRAFT -> COMPLETED)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerCode}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
