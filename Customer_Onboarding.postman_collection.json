    },
    {
      "name": "3. Customer Documents (step 5)",
      "description": "Documents are uploaded one file per request, as soon as the user picks them (works for DRAFT and COMPLETED customers). For 10 files the frontend sends 10 upload calls (2-3 at a time).\n\nSame document type uploaded again: the old file is replaced (soft deleted) and its id is returned in replacedDocumentIds, unless the type is listed in app.customer.documents.multiple-allowed-types.",
      "item": [
        {
          "name": "1. Upload Document",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "PDF, PNG or JPEG, max 5 MB. Do NOT add a manual Content-Type header."
                },
                {
