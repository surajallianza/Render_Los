              "raw": "{\n  \"income\": {\n    \"annualIncome\": 1500000.0,\n    \"otherSourceIncome\": 50000.0,\n    \"totalGrossIncome\": 1550000.0,\n    \"totalNetIncome\": 1200000.0,\n    \"incomeTax\": 350000.0,\n    \"incomeTaxFilerStatus\": \"1002001\",\n    \"riskCategory\": \"1002101\"\n  },\n  \"bank\": {\n    \"bankName\": \"State Bank of India\",\n    \"accountNumber\": \"123456789012\",\n    \"accountType\": \"1002201\",\n    \"accountStatus\": \"1002301\"\n  },\n  \"taxReturns\": [\n    {\n      \"financialYear\": \"2024-25\",\n      \"grossIncome\": 1500000.0,\n      \"tdsPaid\": 120000.0\n    }\n  ]\n}",
