        {
          "name": "Discard Draft",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customers",
                "{{customerCode}}"
              ]
            },
            "description": "Cancels an unfinished onboarding: deletes the DRAFT customer, all its step data and its uploaded files, and unlinks the lead. Only allowed while onboardingStatus = DRAFT (409 otherwise)."
          }
