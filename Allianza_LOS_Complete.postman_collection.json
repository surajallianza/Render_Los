				{
					"name": "7. Get Initial Admin User of Bank",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/setup/banks/{{bankId}}/user",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"setup",
								"banks",
								"{{bankId}}",
								"user"
							]
						},
						"description": "Retrieves seeded admin profile for the bank (passwords omitted)."
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Masters - Lookup Management (Part A)",
			"item": [
				{
					"name": "1. Search / List Lookups (With Embedded Sub-Lookups)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/lookups?search=&status=ALL",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups"
							],
							"query": [
								{
									"key": "search",
									"value": "",
									"description": "Optional search term matching code or name/description"
								},
								{
									"key": "status",
									"value": "ALL",
									"description": "Filter by status: ALL, ACTIVE, or INACTIVE"
								}
							]
						},
						"description": "Retrieves lookups with embedded sub-lookups (for UI table row expansion) and count badge."
					},
					"response": []
				},
				{
					"name": "2. Get Lookup by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/lookups/{{lookupId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups",
								"{{lookupId}}"
							]
						},
						"description": "Fetches single lookup record by its primary key ID."
					},
					"response": []
				},
				{
					"name": "3. Create Lookup",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('lookupId', jsonData.data.id);",
									"}",
									"if (jsonData.data && jsonData.data.code) {",
									"    pm.collectionVariables.set('lookupCode', jsonData.data.code);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"10004\",\n  \"name\": \"Loan Types\",\n  \"description\": \"Loan Types\",\n  \"status\": \"Active\",\n  \"is_fixed\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/lookups",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups"
							]
						},
						"description": "Creates a new master lookup. Code must be digits only and unique."
					},
					"response": []
				},
				{
					"name": "4. Update Lookup",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Commercial Loan Types\",\n  \"status\": \"Active\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/lookups/{{lookupId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups",
								"{{lookupId}}"
							]
						},
						"description": "Edits lookup name, description, and status. Disallows deactivating if is_fixed=true."
					},
					"response": []
				},
				{
					"name": "5. Toggle Lookup Status",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"Inactive\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/lookups/{{lookupId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups",
								"{{lookupId}}",
								"status"
							]
						},
						"description": "Toggles lookup active/inactive status."
					},
					"response": []
				},
				{
					"name": "6. Get Sub-Lookups of Parent Lookup",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/lookups/{{lookupId}}/sub-lookups",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups",
								"{{lookupId}}",
								"sub-lookups"
							]
						},
						"description": "Retrieves all sub-lookups ordered by display_order, then sub_type_code."
					},
					"response": []
				},
				{
					"name": "7. Create Sub-Lookup Under Lookup",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.id) {",
									"    pm.collectionVariables.set('subLookupId', jsonData.data.id);",
									"}",
									"if (jsonData.data && (jsonData.data.sub_lookup_code || jsonData.data.code)) {",
									"    pm.collectionVariables.set('subLookupCode', jsonData.data.sub_lookup_code || jsonData.data.code);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"4\",\n  \"sub_lookup_code\": \"1000801\",\n  \"name\": \"Mr\",\n  \"status\": \"Active\",\n  \"display_order\": 1,\n  \"is_fixed\": false\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/lookups/{{lookupId}}/sub-lookups",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups",
								"{{lookupId}}",
								"sub-lookups"
							]
						},
						"description": "Creates a sub-lookup under parent lookup. The sub_lookup_code format is <lookup_code><sub_code> (e.g. 1000801 where 10008 is lookup code and 01 is sublookup code)."
					},
					"response": []
				},
				{
					"name": "8. Update Sub-Lookup",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Gold Loan Scheme 2026\",\n  \"display_order\": 1,\n  \"status\": \"Active\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/sub-lookups/{{subLookupId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sub-lookups",
								"{{subLookupId}}"
							]
						},
						"description": "Updates sub-lookup name, display order, or status."
					},
					"response": []
				},
				{
					"name": "9. Toggle Sub-Lookup Status",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"Inactive\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/sub-lookups/{{subLookupId}}/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"sub-lookups",
								"{{subLookupId}}",
								"status"
							]
						},
						"description": "Toggles sub-lookup active/inactive."
					},
					"response": []
				}
			]
		},
		{
			"name": "03. Consumer Form Dropdowns (Part B)",
			"item": [
				{
					"name": "1. Single Dropdown by Lookup Code",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/lookups/code/{{lookupCode}}/sub-lookups?activeOnly=true",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups",
								"code",
								"{{lookupCode}}",
								"sub-lookups"
							],
							"query": [
								{
									"key": "activeOnly",
									"value": "true",
									"description": "Filters out inactive options (defaults to true)"
								}
							]
						},
						"description": "Used by forms to populate dropdowns. Returns [{code, name, displayOrder}] sorted by display_order."
					},
					"response": []
				},
				{
					"name": "2. Bulk Dropdowns for Multi-Select Forms",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/lookups/sub-lookups?codes=10004,10005,10002&activeOnly=true",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"lookups",
								"sub-lookups"
							],
							"query": [
								{
									"key": "codes",
									"value": "10004,10005,10002",
									"description": "Comma-separated parent lookup codes"
								},
								{
									"key": "activeOnly",
									"value": "true",
									"description": "Filters out inactive options"
								}
							]
						},
						"description": "Loads options for all form dropdowns in a single HTTP request to eliminate frontend waterfall loading."
					},
					"response": []
				}
			]
		}
	]
}
