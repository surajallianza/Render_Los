	"item": [
		{
			"name": "01. Bank Setup & Onboarding",
			"item": [
				{
					"name": "1. Initialize Bank (Full Payload)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.bankId) {",
									"    pm.collectionVariables.set('bankId', jsonData.data.bankId);",
									"}",
									"if (jsonData.data && jsonData.data.bankCode) {",
									"    pm.collectionVariables.set('bankCode', jsonData.data.bankCode);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bank\": {\n    \"bank_code\": \"ABC001\",\n    \"bank_name\": \"Allianza State Bank\",\n    \"legal_name\": \"Allianza State Bank Ltd\",\n    \"bank_type\": \"COMMERCIAL\",\n    \"contact_email\": \"contact@allianzabank.com\",\n    \"contact_phone\": \"9876543210\",\n    \"pan\": \"ABCDE1234F\",\n    \"gst_no\": \"27ABCDE1234F1Z5\",\n    \"ifsc_code\": \"ALZA0001234\",\n    \"license_no\": \"RBI-LIC-2024-001\",\n    \"website\": \"https://www.allianzabank.com\",\n    \"logo_url\": \"https://www.allianzabank.com/logo.png\",\n    \"status\": \"ACTIVE\",\n    \"regulatory_status\": \"LICENSED\",\n    \"direct_clg_member\": true,\n    \"direct_member_iftas\": true,\n    \"micr1\": \"400\",\n    \"micr2\": \"024\",\n    \"micr3\": \"001\",\n    \"micr_number\": \"400024001\",\n    \"no_of_branches\": 12,\n    \"sponsor_bank_clg\": \"State Bank of India\",\n    \"sponsor_bank_iftas\": \"Reserve Bank of India\",\n    \"address_type\": \"Registered Office\",\n    \"unit_gala\": \"Suite 501, 5th Floor\",\n    \"street_road\": \"MG Road, Financial District\",\n    \"landmark\": \"Near Reserve Bank\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"country\": \"India\",\n    \"pincode\": \"400001\"\n  },\n  \"initial_user\": {\n    \"emp_id\": \"EMP001\",\n    \"username\": \"superadmin\",\n    \"password\": \"Admin@Password123\",\n    \"title\": \"Mr.\",\n    \"first_name\": \"Super\",\n    \"middle_name\": \"A.\",\n    \"last_name\": \"Admin\",\n    \"email\": \"superadmin@allianzabank.com\",\n    \"mobile\": \"9876543210\",\n    \"dob\": \"1990-01-15\",\n    \"gender\": \"MALE\",\n    \"designation\": \"Chief Technology Officer\",\n    \"user_role\": \"SUPER_ADMIN\",\n    \"system_role\": \"1\",\n    \"status\": \"ACTIVE\",\n    \"login_branch\": 0,\n    \"login_time\": \"09:00:00\",\n    \"logout_time\": \"18:00:00\",\n    \"session_timeout\": 30,\n    \"no_of_bad_logins\": 0\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/setup/initialize-bank",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"setup",
								"initialize-bank"
							]
						},
						"description": "Provisions the dedicated PostgreSQL database, runs Flyway migrations, and inserts the Super Admin user."
					},
					"response": []
				},
				{
					"name": "2. Initialize Bank (Minimal Payload)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bank\": {\n    \"bank_code\": \"XYZ002\",\n    \"bank_name\": \"Apex Urban Co-op Bank\"\n  },\n  \"initial_user\": {\n    \"username\": \"admin_xyz\",\n    \"password\": \"Admin@Pass123\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/setup/initialize-bank",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"setup",
								"initialize-bank"
							]
						},
						"description": "Quick setup with mandatory fields only."
					},
					"response": []
				},
				{
					"name": "3. Get All Banks",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/setup/banks",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"setup",
								"banks"
							]
						},
						"description": "Retrieves all registered banks from master setup database."
					},
					"response": []
				},
				{
					"name": "4. Get Bank by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/setup/banks/{{bankId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"setup",
								"banks",
								"{{bankId}}"
							]
						},
						"description": "Retrieves details of a single bank by ID."
					},
					"response": []
				},
				{
					"name": "5. Get Bank by Code",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/setup/banks/code/{{bankCode}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"setup",
								"banks",
								"code",
								"{{bankCode}}"
							]
						},
						"description": "Retrieves bank details by its unique Bank Code."
					},
					"response": []
				},
				{
					"name": "6. Update Bank Details",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"bank_name\": \"Allianza Global Bank\",\n  \"contact_email\": \"support@allianzabank.com\",\n  \"contact_phone\": \"9123456780\",\n  \"no_of_branches\": 25,\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"411001\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/setup/banks/{{bankId}}",
							"host": [
